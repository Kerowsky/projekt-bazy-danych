<Window x:Class="projekt_bazy_danych.ChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Wykres" Height="500" Width="800"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="24,14">
            <TextBlock Text="Wykres zamówień"
                       Style="{StaticResource TextBlockLargeBold}"
                       Foreground="{DynamicResource TextIconBrush}"/>
        </Border>

        <ScottPlot:WpfPlot x:Name="WpfPlotChart" Grid.Row="1" Margin="16"/>
    </Grid>
</Window>
