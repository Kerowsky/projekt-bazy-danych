<Window x:Class="projekt_bazy_danych.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:projekt_bazy_danych"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Language="pl-PL"
        Title="Zamówienia" Height="520" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="24,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Zamówienia"
                           Style="{StaticResource TextBlockLargeBold}"
                           Foreground="{DynamicResource TextIconBrush}"/>
                <TextBlock Text="zarządzanie zamówieniami i pojazdami"
                           Style="{StaticResource TextBlockDefault}"
                           Foreground="{DynamicResource TextIconBrush}"
                           Opacity="0.8"
                           Margin="14,0,0,0"
                           VerticalAlignment="Bottom"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,16,24,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource BorderRegion}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Filtry wyszukiwania"
                               Style="{StaticResource TextBlockSubTitleBold}"
                               Margin="0,0,0,10"/>
                    <hc:UniformSpacingPanel Spacing="12">
                        <TextBox Width="180"
                                 Style="{StaticResource TextBoxExtend}"
                                 hc:InfoElement.Title="Nazwisko klienta"
                                 Text="{Binding FilterNazwisko, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBox Width="180"
                                 Style="{StaticResource TextBoxExtend}"
                                 hc:InfoElement.Title="VIN pojazdu"
                                 Text="{Binding FilterVin, UpdateSourceTrigger=PropertyChanged}"/>

                        <ComboBox Width="180"
                                  Style="{StaticResource ComboBoxExtend}"
                                  hc:InfoElement.Title="Fabryka"
                                  ItemsSource="{Binding Fabryki}"
                                  SelectedItem="{Binding FilterFabryka}"/>

                        <Button Content="Szukaj" Width="90" VerticalAlignment="Bottom"
                                Style="{StaticResource ButtonPrimary}"
                                Command="{Binding SzukajCommand}"/>
                        <Button Content="Wyczyść" Width="90" VerticalAlignment="Bottom"
                                Style="{StaticResource ButtonDefault}"
                                Command="{Binding WyczyscCommand}"/>
                    </hc:UniformSpacingPanel>
                </StackPanel>
            </Border>

            <hc:UniformSpacingPanel Grid.Row="1" Spacing="8" Margin="0,0,0,12">
                <Button Content="+ Dodaj nowe zamówienie"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding DodajCommand}"/>
                <Button Content="Edytuj zaznaczone"
                        Style="{StaticResource ButtonDefault}"
                        Command="{Binding EdytujCommand}"/>
                <Button Content="Usuń zaznaczone"
                        Style="{StaticResource ButtonDanger}"
                        Command="{Binding UsunCommand}"/>
            </hc:UniformSpacingPanel>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Zamowienia}"
                      SelectedItem="{Binding WybraneZamowienie}"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"/>
        </Grid>

        <ScottPlot:WpfPlot x:Name="WpfPlot1" Grid.Row="2" Margin="24,0,24,16"/>
    </Grid>
</Window>
