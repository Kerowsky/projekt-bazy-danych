<Window x:Class="projekt_bazy_danych.DodajZamowienieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:projekt_bazy_danych"
        mc:Ignorable="d"
        Language="pl-PL"
        Title="Dodaj zamówienie" SizeToContent="Height" Width="560"
        Background="#F8F9FA"
        FontFamily="Segoe UI" FontSize="14"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Paleta w stylu Bootstrap 5 (te same style co w MainWindow) -->
        <SolidColorBrush x:Key="Primary" Color="#0D6EFD"/>
        <SolidColorBrush x:Key="Secondary" Color="#6C757D"/>
        <SolidColorBrush x:Key="Dark" Color="#212529"/>
        <SolidColorBrush x:Key="BorderGray" Color="#DEE2E6"/>
        <SolidColorBrush x:Key="InputBorder" Color="#CED4DA"/>
        <SolidColorBrush x:Key="Muted" Color="#6C757D"/>

        <Style x:Key="BsButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BsButton}">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
        </Style>
        <Style x:Key="BtnOutline" TargetType="Button" BasedOn="{StaticResource BsButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Secondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E9ECEF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DEE2E6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#86B7FE"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
        </Style>

        <Style x:Key="BsLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderGray}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Navbar -->
        <Border Grid.Row="0" Background="{StaticResource Dark}" Padding="24,14">
            <TextBlock Text="Nowe zamówienie" Foreground="White" FontSize="18" FontWeight="Bold"/>
        </Border>

        <!-- Karta z formularzem -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="24" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Dane zamówienia" FontSize="16" FontWeight="SemiBold"
                           Margin="0,0,0,16"/>

                <!-- Klient -->
                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <TextBlock Text="Klient" Style="{StaticResource BsLabel}"/>
                    <ComboBox x:Name="cmbKlient"
                              DisplayMemberPath="PelneImie" SelectedValuePath="IdKlienta"/>
                </StackPanel>

                <!-- Pojazd -->
                <StackPanel Grid.Row="2" Margin="0,0,0,14">
                    <TextBlock Text="Pojazd" Style="{StaticResource BsLabel}"/>
                    <ComboBox x:Name="cmbPojazd"
                              DisplayMemberPath="NazwaModelu" SelectedValuePath="VinPojazdu"/>
                </StackPanel>

                <!-- Koszt -->
                <StackPanel Grid.Row="3" Margin="0,0,0,14">
                    <TextBlock Text="Koszt (PLN)" Style="{StaticResource BsLabel}"/>
                    <TextBox x:Name="txtKoszt"/>
                </StackPanel>

                <!-- Przyciski -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Anuluj" Width="90" Height="36" Margin="0,0,8,0"
                            Style="{StaticResource BtnOutline}" IsCancel="True"/>
                    <Button Content="Zapisz" Width="90" Height="36"
                            Style="{StaticResource BtnPrimary}" Click="BtnZapisz_Click" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
