<Window x:Class="projekt_bazy_danych.DodajZamowienieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:projekt_bazy_danych"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Language="pl-PL"
        Title="Dodaj zamówienie" SizeToContent="Height" Width="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="24,14">
            <TextBlock Text="Nowe zamówienie"
                       Style="{StaticResource TextBlockLargeBold}"
                       Foreground="{DynamicResource TextIconBrush}"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource BorderRegion}" Margin="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Klient"
                           Style="{StaticResource TextBlockSubTitleBold}"
                           Margin="0,0,0,10"/>

                <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,6,12"
                         Style="{StaticResource TextBoxExtend}"
                         hc:InfoElement.Title="Imię"
                         hc:InfoElement.Necessary="True"
                         Text="{Binding Imie, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Grid.Row="1" Grid.Column="1" Margin="6,0,0,12"
                         Style="{StaticResource TextBoxExtend}"
                         hc:InfoElement.Title="Nazwisko"
                         hc:InfoElement.Necessary="True"
                         Text="{Binding Nazwisko, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="Pojazd"
                           Style="{StaticResource TextBlockSubTitleBold}"
                           Margin="0,4,0,10"/>

                <TextBox Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,12"
                         Style="{StaticResource TextBoxExtend}"
                         hc:InfoElement.Title="VIN"
                         hc:InfoElement.Necessary="True"
                         MaxLength="17"
                         CharacterCasing="Upper"
                         Text="{Binding Vin, UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox Grid.Row="4" Grid.Column="0" Margin="0,0,6,12"
                          Style="{StaticResource ComboBoxExtend}"
                          hc:InfoElement.Title="Marka"
                          hc:InfoElement.Necessary="True"
                          hc:InfoElement.Placeholder="Wybierz markę"
                          ItemsSource="{Binding Marki}"
                          SelectedItem="{Binding SelectedMarka}"/>

                <ComboBox Grid.Row="4" Grid.Column="1" Margin="6,0,0,12"
                          Style="{StaticResource ComboBoxExtend}"
                          hc:InfoElement.Title="Model"
                          hc:InfoElement.Necessary="True"
                          hc:InfoElement.Placeholder="Wybierz model"
                          ItemsSource="{Binding Modele}"
                          SelectedItem="{Binding SelectedModel}"/>

                <ComboBox Grid.Row="5" Grid.Column="0" Margin="0,0,6,12"
                          Style="{StaticResource ComboBoxExtend}"
                          hc:InfoElement.Title="Typ silnika"
                          hc:InfoElement.Necessary="True"
                          hc:InfoElement.Placeholder="Wybierz typ"
                          ItemsSource="{Binding TypySilnika}"
                          SelectedItem="{Binding SelectedTypSilnika}"/>

                <ComboBox Grid.Row="5" Grid.Column="1" Margin="6,0,0,12"
                          Style="{StaticResource ComboBoxExtend}"
                          hc:InfoElement.Title="Fabryka"
                          hc:InfoElement.Necessary="True"
                          hc:InfoElement.Placeholder="Wybierz fabrykę"
                          ItemsSource="{Binding Fabryki}"
                          SelectedItem="{Binding SelectedFactory}"/>

                <TextBox Grid.Row="6" Grid.Column="0" Margin="0,0,6,12"
                         Style="{StaticResource TextBoxExtend}"
                         hc:InfoElement.Title="Moc (KM)"
                         hc:InfoElement.Necessary="True"
                         Text="{Binding Moc, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBox Grid.Row="6" Grid.Column="1" Margin="6,0,0,12"
                         Style="{StaticResource TextBoxExtend}"
                         hc:InfoElement.Title="Pojemność (cm³)"
                         hc:InfoElement.Placeholder="puste dla elektrycznych"
                         Text="{Binding Pojemnosc, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="Zamówienie"
                           Style="{StaticResource TextBlockSubTitleBold}"
                           Margin="0,4,0,10"/>

                <TextBox Grid.Row="8" Grid.Column="0" Margin="0,0,6,16"
                         Style="{StaticResource TextBoxExtend}"
                         hc:InfoElement.Title="Koszt (zł)"
                         hc:InfoElement.Necessary="True"
                         Text="{Binding Koszt, UpdateSourceTrigger=PropertyChanged}"/>

                <hc:DatePicker Grid.Row="8" Grid.Column="1" Margin="6,0,0,16"
                               Style="{StaticResource DatePickerExtend}"
                               hc:InfoElement.Title="Data zamówienia"
                               hc:InfoElement.Necessary="True"
                               SelectedDate="{Binding DataZamowienia}"/>

                <hc:UniformSpacingPanel Grid.Row="9" Grid.ColumnSpan="2" Spacing="8"
                                        HorizontalAlignment="Right">
                    <Button Content="Anuluj" Width="90"
                            Style="{StaticResource ButtonDefault}"
                            IsCancel="True"/>
                    <Button Content="Zapisz" Width="90"
                            Style="{StaticResource ButtonPrimary}"
                            Command="{Binding ZapiszCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                            IsDefault="True"/>
                </hc:UniformSpacingPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
