<Window x:Class="projekt_bazy_danych.DodajZamowienieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:projekt_bazy_danych"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        mc:Ignorable="d"
        Language="pl-PL"
        Title="Dodaj zamówienie" SizeToContent="Height" Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="24,14">
            <TextBlock Text="Nowe zamówienie"
                       Style="{StaticResource TextBlockLargeBold}"
                       Foreground="{DynamicResource TextIconBrush}"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource BorderRegion}" Margin="24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Dane zamówienia"
                           Style="{StaticResource TextBlockSubTitleBold}"
                           Margin="0,0,0,16"/>

                <ComboBox Grid.Row="1" Margin="0,0,0,14"
                          Style="{StaticResource ComboBoxExtend}"
                          hc:InfoElement.Title="Klient"
                          ItemsSource="{Binding Klienci}"
                          DisplayMemberPath="PelneImie"
                          SelectedItem="{Binding WybranyKlient}"/>

                <ComboBox Grid.Row="2" Margin="0,0,0,14"
                          Style="{StaticResource ComboBoxExtend}"
                          hc:InfoElement.Title="Pojazd"
                          ItemsSource="{Binding Pojazdy}"
                          DisplayMemberPath="NazwaModelu"
                          SelectedItem="{Binding WybranyPojazd}"/>

                <TextBox Grid.Row="3" Margin="0,0,0,14"
                         Style="{StaticResource TextBoxExtend}"
                         hc:InfoElement.Title="Koszt (PLN)"
                         Text="{Binding Koszt, UpdateSourceTrigger=PropertyChanged}"/>

                <hc:UniformSpacingPanel Grid.Row="4" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Anuluj" Width="90"
                            Style="{StaticResource ButtonDefault}"
                            IsCancel="True"/>
                    <Button Content="Zapisz" Width="90"
                            Style="{StaticResource ButtonPrimary}"
                            Command="{Binding ZapiszCommand}" IsDefault="True"/>
                </hc:UniformSpacingPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
